#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0) readonly buffer B0 { uint data[]; } a;
layout(set=0,binding=1) readonly buffer B1 { uint data[]; } b;
layout(set=0,binding=2) readonly buffer B2 { uint data[]; } c;
layout(set=0,binding=3) buffer Out { uint data[]; } output_data;
layout(set=0,binding=4) uniform utexture2D image_data;
layout(set=0,binding=5) uniform sampler image_sampler;
layout(push_constant) uniform Index { uint k; } pc;
void main() {
    output_data.data[pc.k] =
        a.data[pc.k] + b.data[pc.k] + c.data[pc.k] +
        texelFetch(usampler2D(image_data, image_sampler), ivec2(0, 0), 0).r;
}
